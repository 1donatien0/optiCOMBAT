<UserControl
    x:Class="optiCombat.WinUI.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:optiCombat.WinUI.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    SizeChanged="Page_SizeChanged">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppCardStyle}" Padding="20,14">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ProtectionHeadline"
                        FontSize="26"
                        FontWeight="SemiBold"
                        loc:Loc.Text="Overview_Protected" />
                    <TextBlock
                        x:Name="ProtectionSubtitle"
                        MaxWidth="480"
                        Foreground="{ThemeResource TextMutedBrush}"
                        FontSize="14"
                        loc:Loc.Text="Overview_ProtectedSub"
                        TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="13"
                            Foreground="{ThemeResource AccentBrush}"
                            Glyph="&#xE823;" />
                        <TextBlock Foreground="{ThemeResource AccentBrush}" loc:Loc.Text="Overview_LastScan" />
                        <TextBlock
                            x:Name="LastScanText"
                            Foreground="{ThemeResource AccentBrush}"
                            FontWeight="SemiBold"
                            loc:Loc.Text="Common_Never" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="HeroBrandPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image
                        Width="108"
                        Height="108"
                        Source="ms-appx:///Assets/optiCombat_hero.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="36" FontWeight="Bold">
                            <Run Text="opti" />
                            <Run Foreground="{ThemeResource AccentBrush}" Text="COMBAT" />
                        </TextBlock>
                        <TextBlock
                            Foreground="{ThemeResource TextMutedBrush}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="PROTECT  -  DETECT  -  DEFEND" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ActionGrid" Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ActionCleanBtn" Tag="clean" Click="Action_Click" Style="{StaticResource TileButtonStyle}">
                <StackPanel MinHeight="52" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Foreground="{ThemeResource WarningBrush}" Glyph="&#xE90F;" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileTitleStyle}" loc:Loc.Text="Nav_Clean" />
                        <TextBlock Style="{StaticResource TileSubtitleStyle}" loc:Loc.Text="Overview_CleanSub" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="ActionScanBtn" Grid.Column="1" Tag="antivirus" Style="{StaticResource TileButtonStyle}">
                <StackPanel MinHeight="52" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Foreground="{ThemeResource AccentBrush}" Glyph="&#xE83D;" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileTitleStyle}" loc:Loc.Text="Nav_Antivirus" />
                        <TextBlock Style="{StaticResource TileSubtitleStyle}" loc:Loc.Text="Overview_ScanSub" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="ActionHistoryBtn" Grid.Column="2" Tag="history" Click="Action_Click" Style="{StaticResource TileButtonStyle}">
                <StackPanel MinHeight="52" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Foreground="{ThemeResource InfoBrush}" Glyph="&#xE81C;" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileTitleStyle}" loc:Loc.Text="Nav_History" />
                        <TextBlock Style="{StaticResource TileSubtitleStyle}" loc:Loc.Text="Overview_HistorySub" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="ActionUpdateBtn" Grid.Column="3" Tag="update" Click="Action_Click" Style="{StaticResource TileButtonStyle}">
                <StackPanel MinHeight="52" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Foreground="{ThemeResource VioletBrush}" Glyph="&#xE895;" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileTitleStyle}" loc:Loc.Text="Overview_UpdateTitle" />
                        <TextBlock Style="{StaticResource TileSubtitleStyle}" loc:Loc.Text="Overview_UpdateSub" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <Border
            x:Name="ElevationBanner"
            Grid.Row="4"
            Padding="12,8"
            Background="{ThemeResource WarningTintBrush}"
            BorderBrush="{ThemeResource WarningBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Foreground="{ThemeResource WarningBrush}" Glyph="&#xE7BA;" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource WarningBrush}"
                    loc:Loc.Text="Overview_PartialScanWarning"
                    TextWrapping="WrapWholeWords" />
                <Button
                    Grid.Column="2"
                    Click="RunAsAdmin_Click"
                    loc:Loc.Content="Overview_RunAsAdmin" />
            </Grid>
        </Border>

        <Grid x:Name="BottomCardsGrid" Grid.Row="6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StatsCard" Style="{StaticResource OverviewCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" loc:Loc.Text="Av_Stats" />
                    <TextBlock
                        x:Name="ProtectionStatsUpdated"
                        Foreground="{ThemeResource TextMutedBrush}"
                        FontSize="12"
                        loc:Loc.Text="Overview_RefreshedNow" />
                    <Border Padding="10" Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="8" VerticalAlignment="Stretch">
                        <TextBlock
                            x:Name="ProtectionStatsBody"
                            LineHeight="18"
                            FontSize="12"
                            loc:Loc.Text="Overview_StatsEmpty"
                            TextWrapping="WrapWholeWords" />
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="RecsCard" Grid.Column="1" Style="{StaticResource OverviewCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" loc:Loc.Text="Overview_Recommendations" />
                    <Border Padding="10" Background="{ThemeResource CardAltBackgroundBrush}" CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" loc:Loc.Text="Overview_SecurityScore" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="SecurityScore"
                                    Foreground="{ThemeResource AccentBrush}"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Text="--" />
                                <TextBlock
                                    Margin="4,0,0,4"
                                    VerticalAlignment="Bottom"
                                    Foreground="{ThemeResource TextMutedBrush}"
                                    Text="/100" />
                            </StackPanel>
                            <ItemsControl x:Name="PostureIssues" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10" Background="{ThemeResource AccentTintBrush}" CornerRadius="8">
                        <TextBlock
                            x:Name="HygieneRecommendation"
                            Foreground="{ThemeResource AccentBrush}"
                            FontSize="12"
                            loc:Loc.Text="Risk_Rec_Healthy"
                            TextWrapping="WrapWholeWords" />
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="ProtectionCard" Grid.Column="2" Style="{StaticResource OverviewCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" loc:Loc.Text="Overview_ProtectionState" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Foreground="{ThemeResource AccentBrush}" Glyph="&#xE83D;" />
                        <TextBlock Grid.Column="1" Margin="8,0" Foreground="{ThemeResource TextMutedBrush}" FontSize="12" Text="ClamAV" />
                        <TextBlock x:Name="ClamAvStatus" Grid.Column="2" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentBrush}" loc:Loc.Text="Overview_ClamActive" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Foreground="{ThemeResource InfoBrush}" Glyph="&#xE950;" />
                        <TextBlock Grid.Column="1" Margin="8,0" Foreground="{ThemeResource TextMutedBrush}" FontSize="12" loc:Loc.Text="Overview_YaraRulesLabel" />
                        <TextBlock x:Name="YaraStatus" Grid.Column="2" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource InfoBrush}" Text="--" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" />
                    <StackPanel x:Name="PlatformStatusList" Spacing="4" />
                    <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="YARA" />
                            <TextBlock x:Name="YaraPackVersion" FontSize="18" FontWeight="Bold" Text="--" />
                            <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="11" loc:Loc.Text="Overview_LastUpdateShort" />
                            <TextBlock x:Name="YaraLastUpdate" FontSize="12" Text="--" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Text="ClamAV" />
                            <TextBlock x:Name="ClamDbVersion" FontSize="18" FontWeight="Bold" Text="--" />
                            <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="11" loc:Loc.Text="Overview_LastUpdateShort" />
                            <TextBlock x:Name="ClamLastUpdate" FontSize="12" Text="--" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
