<UserControl
    x:Class="optiCombat.WinUI.Views.UpdatesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:optiCombat.WinUI.ViewModels"
    xmlns:loc="using:optiCombat.WinUI.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="0,12,0,0">
            <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="12" TextWrapping="WrapWholeWords" loc:Loc.Text="Upd_Hint" />

            <!-- Actions -->
            <Border Padding="12,8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button Click="Scan_Click" MinWidth="120" IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock VerticalAlignment="Center" loc:Loc.Text="Upd_Scan" />
                        </StackPanel>
                    </Button>
                    <Button Click="UpdateSelected_Click" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanUpdateSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock VerticalAlignment="Center" loc:Loc.Text="Upd_InstallSelected" />
                        </StackPanel>
                    </Button>
                    <Button Click="UpdateAll_Click" IsEnabled="{x:Bind ViewModel.CanUpdateAll, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="14" />
                            <TextBlock VerticalAlignment="Center" loc:Loc.Text="Upd_InstallAll" />
                        </StackPanel>
                    </Button>
                    <Button Click="WindowsUpdate_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                            <TextBlock VerticalAlignment="Center" loc:Loc.Text="Upd_Windows" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" MinHeight="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Liste des mises à jour -->
                <Border Grid.Column="0" Padding="16" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="220" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" loc:Loc.Text="Upd_ListTitle" />
                        <Grid Grid.Row="1">
                            <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UpdateRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Tag, Mode=OneWay}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource WarningBrush}"
                                                       Visibility="{x:Bind IsWarning, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Tag, Mode=OneWay}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource DangerBrush}"
                                                       Visibility="{x:Bind IsDanger, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                                <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" loc:Loc.Text="Upd_EmptyTitle" />
                                <TextBlock Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" loc:Loc.Text="Upd_EmptySub" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Journal -->
                <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardAltBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="220" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" loc:Loc.Text="Upd_LogTitle" />
                        <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
