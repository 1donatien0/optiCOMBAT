<UserControl
    x:Class="optiCombat.WinUI.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:optiCombat.WinUI.Services">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpacingM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppCardStyle}" Padding="20,16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" loc:Loc.Text="Nav_Clean" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" loc:Loc.Text="Clean_Subtitle" />
            </StackPanel>
        </Border>

        <SelectorBar x:Name="OptimiserTabs" Grid.Row="1" SelectionChanged="OptimiserTabs_SelectionChanged">
            <SelectorBarItem x:Name="CleanTab" loc:Loc.Text="Opti_TabClean">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="UpdatesTab" loc:Loc.Text="Opti_TabUpdates">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TweaksTab" loc:Loc.Text="Opti_TabTweaks">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <Grid Grid.Row="2">
            <Grid x:Name="CleanPanel" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" loc:Loc.Text="Clean_SystemTemps" />
                            <TextBlock x:Name="TempSizeText" Style="{StaticResource MetricValueStyle}" Text="0 Mo" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" loc:Loc.Text="Clean_BrowserCaches" />
                            <TextBlock x:Name="BrowserSizeText" Style="{StaticResource MetricValueStyle}" Text="0 Mo" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AppCardStyle}" Background="{ThemeResource AccentBrush}" BorderThickness="0">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Foreground="{ThemeResource OnAccentForegroundBrush}" loc:Loc.Text="Clean_TotalRecoverable" />
                            <TextBlock x:Name="TotalSizeText" Style="{StaticResource MetricValueStyle}" Foreground="{ThemeResource OnAccentForegroundBrush}" Text="0 Mo" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource ToolbarCardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="BusyRing" Width="22" Height="22" Visibility="Collapsed" VerticalAlignment="Center" />
                        <Button Click="Analyze_Click" loc:Loc.Content="Clean_Analyze" x:Name="AnalyzeButton" MinWidth="120" />
                        <Button Click="Clean_Click" Style="{StaticResource AccentButtonStyle}" loc:Loc.Content="Clean_Run" x:Name="CleanButton" IsEnabled="False" MinWidth="150" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" loc:Loc.Text="Clean_System" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="ChkWUCache" Grid.Row="2" loc:Loc.Content="Clean_WUCacheCb" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkDns" Grid.Row="2" Grid.Column="1" loc:Loc.Content="Clean_DnsCb" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkTempWin" loc:Loc.Content="Clean_TempWinCb" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkTempUser" Grid.Column="1" loc:Loc.Content="Clean_TempUserCb" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkRecycle" Grid.Row="1" loc:Loc.Content="Clean_RecycleCb" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkLogs" Grid.Row="1" Grid.Column="1" loc:Loc.Content="Clean_WindowsLogsCb" Checked="Option_Changed" Unchecked="Option_Changed" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,6,0,0" loc:Loc.Text="Clean_BrowsersSection" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="ChkEdge" Content="Microsoft Edge" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkChrome" Grid.Column="1" Content="Google Chrome" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkFirefox" Grid.Row="1" Content="Mozilla Firefox" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkBrave" Grid.Row="1" Grid.Column="1" Content="Brave" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkOpera" Grid.Row="2" Content="Opera" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkVivaldi" Grid.Row="2" Grid.Column="1" Content="Vivaldi" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkArc" Grid.Row="3" Content="Arc" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="ChkHistory" Grid.Row="3" Grid.Column="1" loc:Loc.Content="Clean_HistoryCb" loc:Loc.Tip="Clean_HistoryTooltip" Checked="Option_Changed" Unchecked="Option_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="220" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" loc:Loc.Text="Clean_LogTitle" />
                            <Border Grid.Row="1" Style="{StaticResource LogConsoleBorderStyle}">
                                <Grid>
                                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="LogText" Style="{StaticResource LogMonospaceStyle}" IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                    <StackPanel x:Name="EmptyLogState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                                        <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SuccessGreen}" HorizontalAlignment="Center" />
                                        <TextBlock Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" TextAlignment="Center" loc:Loc.Text="Clean_LogHint" />
                                    </StackPanel>
                                    <ProgressRing x:Name="LogProgress" Width="36" Height="36" IsActive="False" Visibility="Collapsed"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button x:Name="CopyLogButton" Grid.Row="2" HorizontalAlignment="Right" Click="CopyLog_Click" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock loc:Loc.Text="Clean_CopyLog" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ContentControl x:Name="UpdatesHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:Name="TweaksHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
