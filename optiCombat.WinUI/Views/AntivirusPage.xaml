<UserControl
    x:Class="optiCombat.WinUI.Views.AntivirusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:optiCombat.WinUI.Services">

    <Grid x:Name="PageRoot" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpacingM}" SizeChanged="PageRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppCardStyle}" Padding="20,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" loc:Loc.Text="Nav_Antivirus" />
                    <TextBlock x:Name="LastScanText" Style="{StaticResource MutedCaptionStyle}" loc:Loc.Text="Av_NoScan" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="BadgeDot" Width="8" Height="8" Fill="{ThemeResource AccentBrush}" />
                    <TextBlock x:Name="BadgeText" VerticalAlignment="Center" loc:Loc.Text="Av_ProtectionActive" />
                </StackPanel>
            </Grid>
        </Border>

        <SelectorBar x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">
            <SelectorBarItem x:Name="ScanTab" loc:Loc.Text="Av_TabScan">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="SignaturesTab" loc:Loc.Text="Av_TabSignatures">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="QuarantineTab" loc:Loc.Text="Av_TabQuarantine">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE72E;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <Grid Grid.Row="2">
            <Grid x:Name="ScanPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="ScanHubPanel" ColumnSpacing="10" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="QuickScanBtn" Click="QuickScan_Click" Style="{StaticResource TileButtonStyle}" MinHeight="88">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Style="{StaticResource TileTitleStyle}" loc:Loc.Text="ScanType_Quick" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FullScanBtn" Grid.Column="1" Click="FullScan_Click" Style="{StaticResource TileButtonStyle}" MinHeight="88">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Style="{StaticResource TileTitleStyle}" loc:Loc.Text="ScanType_Full" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="ManualScanCol" Grid.Column="2" Spacing="8">
                        <Button Click="BrowseFolder_Click" MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock loc:Loc.Text="Av_ScanFolder" />
                            </StackPanel>
                        </Button>
                        <Button Click="BrowseFile_Click" MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock loc:Loc.Text="Av_ScanFile" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="RecentRow" Grid.Row="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedCaptionStyle}" loc:Loc.Text="Av_Recent" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="RecentTarget_Click" Tag="{Binding}" Padding="10,4" CornerRadius="14"
                                        ToolTipService.ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding ListLabel}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border x:Name="ScanProgressPanel" Grid.Row="2" Style="{StaticResource InsetPanelStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" />
                        <TextBlock x:Name="ScanStatusText" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="ScanCurrentItemText" Style="{StaticResource MutedCaptionStyle}" TextWrapping="WrapWholeWords" />
                        <Button Click="StopScan_Click" loc:Loc.Content="Av_StopScan" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Grid x:Name="StatsThreatsGrid" Grid.Row="3" ColumnSpacing="12" RowSpacing="12" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatsCard" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" loc:Loc.Text="Av_Stats" />
                            <TextBlock x:Name="FilesScannedText" />
                            <TextBlock x:Name="ThreatsFoundText" />
                            <TextBlock x:Name="QuarantineCountText" />
                            <Button x:Name="QuarantineAllButton" Click="QuarantineAll_Click" loc:Loc.Content="Av_QuarantineAll" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ThreatsCard" Grid.Column="1" Style="{StaticResource AppCardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" loc:Loc.Text="Av_ThreatsDetected" />
                            <ListView x:Name="ThreatsList" Grid.Row="1" MinHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding VirusName}" />
                                                <TextBlock Style="{StaticResource MutedCaptionStyle}" Text="{Binding FilePath}" TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowIconButtonStyle}" Click="Reputation_Click" Tag="{Binding FilePath}" loc:Loc.Tip="Av_Tooltip_Reputation">
                                                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButtonStyle}" Click="IgnoreThreat_Click" Tag="{Binding FilePath}" loc:Loc.Tip="Av_IgnoreBtn">
                                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButtonStyle}" Click="QuarantineThreat_Click" Tag="{Binding FilePath}" loc:Loc.Tip="Av_QuarantineBtn">
                                                    <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButtonStyle}" Click="DeleteThreat_Click" Tag="{Binding FilePath}" loc:Loc.Tip="Av_DeleteBtn">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource DangerBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyThreatsState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE83D;" FontSize="32" Foreground="{ThemeResource SuccessGreen}" />
                                <TextBlock Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" loc:Loc.Text="Av_NoThreats" />
                                <TextBlock Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" TextAlignment="Center" loc:Loc.Text="Av_SystemClean" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="SignaturesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource AppCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="YARA" />
                                <TextBlock x:Name="YaraVersionText" Style="{StaticResource MetricValueStyle}" Text="—" />
                                <TextBlock x:Name="YaraUpdateText" Style="{StaticResource MutedCaptionStyle}" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="ClamAV" />
                                <TextBlock x:Name="ClamVersionText" Style="{StaticResource MetricValueStyle}" Text="—" />
                                <TextBlock x:Name="ClamUpdateText" Style="{StaticResource MutedCaptionStyle}" Text="—" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="UpdateSignaturesButton" Click="UpdateSignatures_Click" loc:Loc.Content="Av_UpdateSignatures" />
                        <Button x:Name="StopUpdateButton" Click="StopUpdate_Click" loc:Loc.Content="Av_StopUpdate" Visibility="Collapsed" />
                    </StackPanel>
                    <ProgressBar x:Name="SigUpdateProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <Border Style="{StaticResource LogConsoleBorderStyle}">
                        <TextBlock x:Name="SignatureLogText" Style="{StaticResource LogMonospaceStyle}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="QuarantinePanel" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="QuarantineHeaderText" Style="{StaticResource SectionTitleStyle}" loc:Loc.Text="Av_QuarantineItems" />
                <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" Padding="4">
                    <ListView x:Name="QuarantineList" MinHeight="280">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                        <TextBlock Style="{StaticResource MutedCaptionStyle}" Text="{Binding VirusName}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="RestoreQuarantine_Click" Tag="{Binding Id}" loc:Loc.Content="Av_Restore" />
                                    <Button Grid.Column="2" Click="DeleteQuarantine_Click" Tag="{Binding Id}" loc:Loc.Content="Av_Delete" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LoadMoreQuarantineButton" Click="LoadMoreQuarantine_Click" loc:Loc.Content="Av_LoadMore" Visibility="Collapsed" />
                    <TextBlock x:Name="QuarantinePagingText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MutedCaptionStyle}" />
                    <Button x:Name="PurgeQuarantineButton" Grid.Column="2" Click="PurgeQuarantine_Click" loc:Loc.Content="Av_EmptyQuarantine" />
                </Grid>
            </Grid>
        </Grid>

        <ProgressRing x:Name="InitRing" Grid.RowSpan="3" Width="48" Height="48"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="True" />
    </Grid>
</UserControl>
