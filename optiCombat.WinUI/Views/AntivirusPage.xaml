<UserControl
    x:Class="optiCombat.WinUI.Views.AntivirusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:optiCombat.WinUI.Services">

    <Grid Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20,16" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock FontSize="24" FontWeight="SemiBold" loc:Loc.Text="Nav_Antivirus" />
                    <TextBlock x:Name="LastScanText" Foreground="{ThemeResource TextMutedBrush}" loc:Loc.Text="Av_NoScan" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="BadgeDot" Width="8" Height="8" Fill="{ThemeResource AccentBrush}" />
                    <TextBlock x:Name="BadgeText" VerticalAlignment="Center" loc:Loc.Text="Av_ProtectionActive" />
                </StackPanel>
            </Grid>
        </Border>

        <TabView x:Name="Tabs" Grid.Row="1" Margin="0,14,0,0" IsAddTabButtonVisible="False">
            <TabViewItem loc:Loc.Header="Av_TabScan" IsSelected="True" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE721;" />
                </TabViewItem.IconSource>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="ScanHubPanel" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="QuickScan_Click" MinHeight="88">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock FontWeight="SemiBold" loc:Loc.Text="ScanType_Quick" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="FullScan_Click" MinHeight="88">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock FontWeight="SemiBold" loc:Loc.Text="ScanType_Full" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Spacing="8">
                            <Button Click="BrowseFolder_Click" MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                    <TextBlock loc:Loc.Text="Av_ScanFolder" />
                                </StackPanel>
                            </Button>
                            <Button Click="BrowseFile_Click" MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                    <TextBlock loc:Loc.Text="Av_ScanFile" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="RecentRow" Grid.Row="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" FontSize="12"
                                   loc:Loc.Text="Av_Recent" />
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="RecentTarget_Click" Tag="{Binding}" Padding="10,4" CornerRadius="14"
                                            ToolTipService.ToolTip="{Binding Path}">
                                        <TextBlock Text="{Binding ListLabel}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border x:Name="ScanProgressPanel" Grid.Row="2" Padding="16" Background="{ThemeResource CardAltBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" />
                            <TextBlock x:Name="ScanStatusText" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="ScanCurrentItemText" Foreground="{ThemeResource TextMutedBrush}"
                                       FontSize="12" TextWrapping="WrapWholeWords" />
                            <Button Click="StopScan_Click" loc:Loc.Content="Av_StopScan" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" loc:Loc.Text="Av_Stats" />
                            <TextBlock x:Name="FilesScannedText" Text="Fichiers : 0" />
                            <TextBlock x:Name="ThreatsFoundText" Text="Menaces : 0" />
                            <TextBlock x:Name="QuarantineCountText" Text="Quarantaine : 0" />
                            <Button Click="QuarantineAll_Click" loc:Loc.Content="Av_QuarantineAll" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" loc:Loc.Text="Av_ThreatsDetected" />
                                <ListView x:Name="ThreatsList" MinHeight="220">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding VirusName}" />
                                                    <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="12"
                                                               Text="{Binding FilePath}" TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Click="Reputation_Click" Tag="{Binding FilePath}" Padding="8,6" loc:Loc.Tip="Av_Tooltip_Reputation">
                                                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                                                    </Button>
                                                    <Button Click="IgnoreThreat_Click" Tag="{Binding FilePath}" Padding="8,6" loc:Loc.Tip="Av_IgnoreBtn">
                                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                                    </Button>
                                                    <Button Click="QuarantineThreat_Click" Tag="{Binding FilePath}" Padding="8,6" loc:Loc.Tip="Av_QuarantineBtn">
                                                        <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                                                    </Button>
                                                    <Button Click="DeleteThreat_Click" Tag="{Binding FilePath}" Padding="8,6" loc:Loc.Tip="Av_DeleteBtn">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource DangerBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem loc:Loc.Header="Av_TabSignatures" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE895;" />
                </TabViewItem.IconSource>
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="YARA" />
                            <TextBlock x:Name="YaraVersionText" FontSize="20" Text="—" />
                            <TextBlock x:Name="YaraUpdateText" Foreground="{ThemeResource TextMutedBrush}" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="ClamAV" />
                            <TextBlock x:Name="ClamVersionText" FontSize="20" Text="—" />
                            <TextBlock x:Name="ClamUpdateText" Foreground="{ThemeResource TextMutedBrush}" Text="—" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="UpdateSignaturesButton" Click="UpdateSignatures_Click" loc:Loc.Content="Av_UpdateSignatures" />
                        <Button x:Name="StopUpdateButton" Click="StopUpdate_Click" loc:Loc.Content="Av_StopUpdate" Visibility="Collapsed" />
                    </StackPanel>
                    <ProgressBar x:Name="SigUpdateProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="260">
                        <TextBlock x:Name="SignatureLogText" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" />
                    </ScrollViewer>
                </StackPanel>
            </TabViewItem>

            <TabViewItem loc:Loc.Header="Av_TabQuarantine" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE72E;" />
                </TabViewItem.IconSource>
                <StackPanel Spacing="10">
                    <TextBlock x:Name="QuarantineHeaderText" loc:Loc.Text="Av_QuarantineItems" />
                    <ListView x:Name="QuarantineList" MinHeight="280">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                        <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="12" Text="{Binding VirusName}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="RestoreQuarantine_Click" Tag="{Binding Id}" loc:Loc.Content="Av_Restore" />
                                    <Button Grid.Column="2" Click="DeleteQuarantine_Click" Tag="{Binding Id}" loc:Loc.Content="Av_Delete" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LoadMoreQuarantineButton" Click="LoadMoreQuarantine_Click" loc:Loc.Content="Av_LoadMore" Visibility="Collapsed" />
                        <TextBlock x:Name="QuarantinePagingText" Grid.Column="1" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextMutedBrush}" FontSize="12" />
                        <Button x:Name="PurgeQuarantineButton" Grid.Column="2" Click="PurgeQuarantine_Click" loc:Loc.Content="Av_EmptyQuarantine" />
                    </Grid>
                </StackPanel>
            </TabViewItem>
        </TabView>

        <ProgressRing x:Name="InitRing" Grid.RowSpan="2" Width="48" Height="48"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="True" />
    </Grid>
</UserControl>
