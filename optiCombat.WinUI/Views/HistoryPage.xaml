<UserControl
    x:Class="optiCombat.WinUI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:optiCombat.WinUI.Services">

    <UserControl.Resources>
        <loc:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource SpacingM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" MinHeight="160" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppCardStyle}" Padding="20,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" loc:Loc.Text="Nav_History" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" loc:Loc.Text="Hist_Subtitle" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="ExportHtml_Click" loc:Loc.Content="Hist_ExportHtml" />
                    <Button Click="ExportPdf_Click" loc:Loc.Content="Hist_ExportPdfTitle" x:Name="ExportPdfButton" />
                    <Button Click="OpenAntivirus_Click" Style="{StaticResource AccentButtonStyle}" loc:Loc.Content="Nav_Antivirus" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="ChipAll" Style="{StaticResource FilterChipStyle}" IsChecked="True" Click="Chip_Click" Tag="All" />
                    <ToggleButton x:Name="ChipThreats" Style="{StaticResource FilterChipStyle}" Click="Chip_Click" Tag="Threats" />
                    <ToggleButton x:Name="ChipCleanScans" Style="{StaticResource FilterChipStyle}" Click="Chip_Click" Tag="CleanScans" />
                    <ToggleButton x:Name="ChipCleans" Style="{StaticResource FilterChipStyle}" Click="Chip_Click" Tag="Cleans" />
                    <ToggleButton x:Name="ChipQuarantine" Style="{StaticResource FilterChipStyle}" Click="Chip_Click" Tag="Quarantine" />
                </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Column="1" loc:Loc.Placeholder="Hist_SearchPlaceholder" TextChanged="Search_TextChanged" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="8">
            <Grid>
                <ListView x:Name="TimelineList" SelectionChanged="TimelineList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource MutedCaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{Binding TargetDisplay}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="{Binding DetailDisplay}" Style="{StaticResource MutedCaptionStyle}" />
                                <TextBlock Grid.Column="4" Text="{Binding ResultSummary}" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE81C;" FontSize="36" Foreground="{ThemeResource AccentBrush}" />
                    <TextBlock x:Name="EmptyTitleText" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptySubtitleText" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" MaxWidth="420" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SessionInfoText" VerticalAlignment="Center" Style="{StaticResource MutedCaptionStyle}" TextWrapping="WrapWholeWords" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" x:Name="ScanActionsPanel" Visibility="Collapsed">
                <Button Click="TreatInAntivirus_Click" loc:Loc.Content="Hist_TreatInAv" loc:Loc.Tip="Hist_TooltipTreatInAv" />
                <Button Click="QuarantineAll_Click" loc:Loc.Content="Av_QuarantineAll" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource AppCardStyle}">
            <Grid>
                <StackPanel x:Name="ScanDetailPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="DetailText" TextWrapping="WrapWholeWords" />
                    <ListView x:Name="ThreatsList" MinHeight="100">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding VirusName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <Button Click="ViewInQuarantine_Click" Tag="{Binding FilePath}" loc:Loc.Content="Hist_ViewInQuarantine"
                                                Visibility="{Binding CanViewInQuarantine, Converter={StaticResource BoolToVis}}" />
                                        <Button Click="QuarantineThreat_Click" Tag="{Binding FilePath}" loc:Loc.Content="Av_QuarantineBtn"
                                                Visibility="{Binding CanQuarantine, Converter={StaticResource BoolToVis}}" />
                                        <Button Click="DismissThreat_Click" Tag="{Binding FilePath}" loc:Loc.Content="Av_IgnoreBtn" loc:Loc.Tip="Hist_TooltipDismiss"
                                                Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVis}}" />
                                        <Button Click="IgnoreThreat_Click" Tag="{Binding FilePath}" loc:Loc.Content="Hist_Exclude" />
                                        <Button Click="DeleteThreat_Click" Tag="{Binding FilePath}" loc:Loc.Content="Av_Delete" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <ScrollViewer x:Name="CleanDetailPanel" Visibility="Collapsed">
                    <TextBlock x:Name="CleanLogText" Style="{StaticResource LogMonospaceStyle}" />
                </ScrollViewer>

                <StackPanel x:Name="QuarantineDetailPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Name="QuarTitleText" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="QuarPathText" TextWrapping="WrapWholeWords" FontSize="12" />
                    <TextBlock x:Name="QuarMetaText" Style="{StaticResource MutedCaptionStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ViewSourceScan_Click" loc:Loc.Content="Hist_ViewSourceScan" x:Name="ViewSourceScanButton" Visibility="Collapsed" />
                        <Button Click="ManageInAv_Click" loc:Loc.Content="Hist_ManageInAv" loc:Loc.Tip="Hist_TooltipManageInAv" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="NoSelectionText" VerticalAlignment="Center" Style="{StaticResource MutedCaptionStyle}" loc:Loc.Text="Hist_SelectEntry" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
