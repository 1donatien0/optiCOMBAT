<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>optiCombat</AssemblyName>
    <RootNamespace>optiCombat.WinUI</RootNamespace>
    <Company>optiCombat</Company>
    <Product>optiCombat v1.0 - WinUI 3</Product>
    <Copyright>Copyright 2026 Dona By</Copyright>
    <ApplicationIcon>..\assets\optiCombat.ico</ApplicationIcon>
    <!--
      Runtime WinUI du système. Le bootstrap x64 doit être à côté de l'exe,
      et app.manifest doit déclarer supportedOS Windows 10, sinon le processus
      quitte avant d'afficher la fenêtre.
    -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <CleanPublishArtifactsBeforePublish Condition="'$(CleanPublishArtifactsBeforePublish)' == ''">true</CleanPublishArtifactsBeforePublish>
  </PropertyGroup>

  <Target Name="CleanStalePublishOutput" BeforeTargets="BeforePublish" Condition="'$(CleanPublishArtifactsBeforePublish)' == 'true'">
    <PropertyGroup>
      <_StalePublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\publish</_StalePublishDir>
    </PropertyGroup>
    <Message Importance="high" Text="optiCombat.WinUI : nettoyage du dossier publish\ périmé avant publication..." />
    <RemoveDir Directories="$(_StalePublishDir)" ContinueOnError="true" />
  </Target>

  <!--
    Application WinUI non empaquetée : le runtime charge $(AssemblyName).pri à côté de l'exe
    (Xaml + images ms-appx). Le SDK le génère dans bin\...\win-x64\ mais ne le recopie pas
    dans publish\. Sans ce fichier, MainWindow.InitializeComponent lève XamlParseException
    et le processus se ferme avant d'afficher la fenêtre.
  -->
  <Target Name="CopyUnpackagedPriToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_UnpackagedPriName Condition="Exists('$(TargetDir)$(AssemblyName).pri')">$(AssemblyName).pri</_UnpackagedPriName>
      <_UnpackagedPriName Condition="'$(_UnpackagedPriName)' == '' and Exists('$(TargetDir)resources.pri')">resources.pri</_UnpackagedPriName>
    </PropertyGroup>
    <Error Condition="'$(_UnpackagedPriName)' == ''"
           Text="optiCombat : PRI introuvable dans $(TargetDir). L'application installée ne pourra pas s'ouvrir." />
    <Copy SourceFiles="$(TargetDir)$(_UnpackagedPriName)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="optiCombat.WinUI : $(_UnpackagedPriName) copié vers $(PublishDir)" />
  </Target>

  <!--
    Publish win-x64 : le SDK dépose le bootstrap des autres RID sous runtimes\,
    mais pas la DLL x64 à côté de l'exe. Indispensable si WindowsAppSDKSelfContained
    est désactivé. En mode self-contained le runtime est embarqué et ce fichier
    n'est pas utilisé.
  -->
  <Target Name="CopyWindowsAppRuntimeBootstrap" AfterTargets="Publish" Condition="'$(WindowsAppSDKSelfContained)' != 'true'">
    <PropertyGroup>
      <_BootstrapRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_BootstrapRid>
      <_BootstrapRid Condition="'$(_BootstrapRid)' == ''">win-x64</_BootstrapRid>
      <_BootstrapRoot Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</_BootstrapRoot>
      <_BootstrapRoot Condition="'$(_BootstrapRoot)' == ''">$(USERPROFILE)\.nuget\packages\</_BootstrapRoot>
      <_BootstrapRoot Condition="!HasTrailingSlash('$(_BootstrapRoot)')">$(_BootstrapRoot)\</_BootstrapRoot>
    </PropertyGroup>
    <ItemGroup>
      <_BootstrapDll Include="$(_BootstrapRoot)microsoft.windowsappsdk.foundation\**\runtimes\$(_BootstrapRid)\native\Microsoft.WindowsAppRuntime.Bootstrap.dll" />
    </ItemGroup>
    <Message Importance="high" Text="optiCombat bootstrap root=$(_BootstrapRoot) fichiers=@(_BootstrapDll)" />
    <Error Condition="'@(_BootstrapDll)' == ''"
           Text="optiCombat : Microsoft.WindowsAppRuntime.Bootstrap.dll ($(_BootstrapRid)) introuvable. L'application installée ne pourra pas s'ouvrir." />
    <Copy SourceFiles="@(_BootstrapDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="optiCombat.WinUI : Microsoft.WindowsAppRuntime.Bootstrap.dll copié vers $(PublishDir)" />
  </Target>

  <Target Name="VerifyWinUiRuntimePublished" AfterTargets="CopyUnpackagedPriToPublish;CopyWindowsAppRuntimeBootstrap">
    <Error Condition="'$(WindowsAppSDKSelfContained)' == 'true' and !Exists('$(PublishDir)Microsoft.UI.Xaml.dll')"
           Text="optiCombat : Microsoft.UI.Xaml.dll absent de $(PublishDir). Le mode self-contained WinUI n'a pas été publié." />
    <Error Condition="'$(WindowsAppSDKSelfContained)' != 'true' and !Exists('$(PublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll')"
           Text="optiCombat : Microsoft.WindowsAppRuntime.Bootstrap.dll absent de $(PublishDir)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\optiCombat.Platform\optiCombat.Platform.csproj" />
    <ProjectReference Include="..\optiCombat.Application\optiCombat.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\optiCombat.ico" Link="Assets\optiCombat.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\assets\optiCombat_hero.png" Link="Assets\optiCombat_hero.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\assets\optiCombat_shield.png" Link="Assets\optiCombat_shield.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\runtime\clamav\x64\**\*" Exclude="..\runtime\clamav\x64\**\*.conf">
      <Link>clamav\x64\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\runtime\clamav\database\**\*">
      <Link>clamav\database\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\runtime\clamav\certs\clamav.crt">
      <Link>clamav\certs\clamav.crt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\runtime\rules\**\*">
      <Link>rules\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\runtime\yara\**\*">
      <Link>yara\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
